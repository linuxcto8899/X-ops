# X-ops 环境变量模板（复制为 .env 后修改）
# 生成密钥：openssl rand -hex 24
DJANGO_SECRET_KEY=please-change-me
DJANGO_DEBUG=false
# 允许访问的域名/IP，逗号分隔；HTTPS 后填域名
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis（Celery broker / 结果后端）
REDIS_URL=redis://127.0.0.1:6379/0

# 数据库（默认 SQLite；设置 DB_HOST 后使用 PostgreSQL）
# DB_HOST=127.0.0.1
# DB_NAME=ops_platform
# DB_USER=ops
# DB_PASSWORD=please-change-me
# DB_PORT=5432

# Docker Compose 使用
# POSTGRES_PASSWORD=please-change-me
# XOPS_PUBLIC_URL=http://localhost

# 时区
TZ=Asia/Shanghai